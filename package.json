{
  "name": "chat-novela",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "frontend:dev": "pnpm --filter frontend dev",
    "backend:dev": "pnpm --filter backend dev",
    "frontend:docker": "docker compose -f frontend/docker-compose.yml up --build",
    "backend:docker": "docker compose -f backend/docker-compose.yml up --build",
    "docker:all": "docker compose -f backend/docker-compose.yml -f frontend/docker-compose.yml up --build",
    "frontend:docker:up": "docker compose -f frontend/docker-compose.yml up",
    "backend:docker:up": "docker compose -f backend/docker-compose.yml up",
    "docker:all:up": "docker compose -f backend/docker-compose.yml -f frontend/docker-compose.yml up",
    "frontend:docker:down": "docker compose -f frontend/docker-compose.yml down",
    "backend:docker:down": "docker compose -f backend/docker-compose.yml down",
    "docker:all:down": "docker compose -f backend/docker-compose.yml -f frontend/docker-compose.yml down",
    "frontend:docker:clean": "docker compose -f frontend/docker-compose.yml down --rmi all --volumes",
    "backend:docker:clean": "docker compose -f backend/docker-compose.yml down --rmi all --volumes",
    "docker:all:clean": "docker compose -f backend/docker-compose.yml -f frontend/docker-compose.yml down --rmi all --volumes"
  }
}
